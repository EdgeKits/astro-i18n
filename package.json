{
  "name": "@edgekits/astro-i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EdgeKits/astro-i18n"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": "./src/runtime.ts",
    "./middleware": "./src/middleware.ts",
    "./components/*": "./src/components/*.astro",
    "./package.json": "./package.json"
  },
  "bin": {
    "edgekits-i18n": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import ./test/register.mjs --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^25.9.1",
    "astro": "^7.3.8",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
