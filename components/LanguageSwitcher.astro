---
import WorldIcon from '@tabler/icons/outline/world.svg'
import PointIcon from '@tabler/icons/filled/point.svg'
import { cn } from '@/utils/cn'

import { SUPPORTED_LOCALES, LANGUAGES } from '../constants'
import type { Locale } from '../constants'
import Flag from '@/components/icons/Flag.astro'

const { uiLocale: currentLang } = Astro.locals
---

<language-switcher data-current-lang={currentLang}>
  <div class="relative">
    <button
      type="button"
      data-ls-trigger
      class="rounded-full"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label="Switch language"
    >
      <WorldIcon class="text-foreground size-5" stroke-width="1" />
    </button>

    <div
      data-ls-dropdown
      class="bg-card animate-in fade-in slide-in-from-top-8 absolute right-8 z-50 -mt-8 hidden w-44 overflow-hidden rounded-lg border shadow-lg duration-300"
      role="menu"
    >
      {
        SUPPORTED_LOCALES.map((lang) => {
          const locale = lang as Locale
          const isActive = locale === currentLang
          const label = LANGUAGES[locale]
          const flagCode = label.countryCode

          return (
            <button
              type="button"
              class={cn(
                'ls-selector hover:bg-muted flex w-44 items-center justify-between px-4 py-2 text-sm',
                isActive && 'bg-background cursor-default',
              )}
              data-lang={locale}
              role="menuitem"
              disabled={isActive}
            >
              <span class="pointer-events-none flex items-center gap-3">
                <Flag code={flagCode} size={16} />
                {label.name}
              </span>
              {isActive && <PointIcon class="size-6" />}
            </button>
          )
        })
      }
    </div>
  </div>
</language-switcher>

<script>
  import { LANG_COOKIE_NAME, type Locale } from '../constants'

  class LanguageSwitcher extends HTMLElement {
    private trigger: HTMLButtonElement | null = null
    private dropdown: HTMLElement | null = null

    connectedCallback() {
      this.trigger = this.querySelector('[data-ls-trigger]')
      this.dropdown = this.querySelector('[data-ls-dropdown]')

      if (!this.trigger || !this.dropdown) return

      this.trigger.addEventListener('click', this.onToggle)
      this.dropdown.addEventListener('click', this.onSelect)
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener('click', this.onToggle)
      this.dropdown?.removeEventListener('click', this.onSelect)
      this.removeGlobalListeners()
    }

    private open() {
      if (!this.dropdown || !this.trigger) return
      this.dropdown.classList.remove('hidden')
      this.trigger.setAttribute('aria-expanded', 'true')

      document.addEventListener('click', this.onDocumentClick)
      document.addEventListener('keydown', this.onKeyDown)
    }

    private close() {
      if (!this.dropdown || !this.trigger) return
      this.dropdown.classList.add('hidden')
      this.trigger.setAttribute('aria-expanded', 'false')

      this.removeGlobalListeners()
    }

    private removeGlobalListeners() {
      document.removeEventListener('click', this.onDocumentClick)
      document.removeEventListener('keydown', this.onKeyDown)
    }

    private onToggle = (e: MouseEvent) => {
      e.stopPropagation()
      if (!this.dropdown) return

      const isHidden = this.dropdown.classList.contains('hidden')
      isHidden ? this.open() : this.close()
    }

    // Isolated logic for getting language from URL
    private getLangFromUrl(pathname: string): string | undefined {
      const segments = pathname.split('/')
      return segments[1] || undefined
    }

    // Isolated logic for substituting language in URLs
    private replaceLocaleInPath(pathname: string, currentLang: string, targetLang: string): string {
      const segments = pathname.split('/')
      if (segments[1] === currentLang) {
        segments[1] = targetLang
      }
      return segments.join('/')
    }

    private onSelect = (event: Event) => {
      const target = event.target as HTMLElement
      const button = target.closest<HTMLButtonElement>('.ls-selector')
      if (!button) return

      const lang = button.dataset.lang as Locale | undefined
      if (!lang) return

      const pathname = window.location.pathname
      const currentLang = this.getLangFromUrl(pathname)

      if (!currentLang) return

      // Persist the EXPLICIT language choice client-side. The i18n middleware
      // no longer creates the cookie on plain page views (a cookie-less request
      // must stay free of Set-Cookie so the HTML edge cache can serve it), so
      // the switcher is the place where the preference is born. Not httpOnly —
      // the server only ever reads it (schema-validated), never trusts it.
      document.cookie = `${LANG_COOKIE_NAME}=${lang}; path=/; max-age=31536000; SameSite=Lax; Secure`

      window.location.href = this.replaceLocaleInPath(pathname, currentLang, lang)
    }

    private onDocumentClick = (event: MouseEvent) => {
      if (!this.contains(event.target as Node)) {
        this.close()
      }
    }

    private onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        this.close()
      }
    }
  }

  if (!customElements.get('language-switcher')) {
    customElements.define('language-switcher', LanguageSwitcher)
  }
</script>
